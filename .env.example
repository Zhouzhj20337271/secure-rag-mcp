# Copy to .env when the application implements loading it. Never commit .env.
# All paths are relative to the project root.
SECURERAG_DATA_DIR=data/mock_docs
SECURERAG_DB_PATH=var/qdrant
SECURERAG_MODEL_CACHE=var/models
SECURERAG_PRINCIPALS_PATH=config/principals.yaml
SECURERAG_PRINCIPAL_ID=engineer-demo
SECURERAG_DENSE_MODEL=BAAI/bge-small-zh-v1.5
SECURERAG_SPARSE_MODEL=Qdrant/bm25
SECURERAG_DENSE_TOP_K=15
SECURERAG_SPARSE_TOP_K=15
SECURERAG_TOP_K=5
SECURERAG_RERANK_ENABLED=false
SECURERAG_RERANK_MODEL=BAAI/bge-reranker-base
SECURERAG_RERANK_CANDIDATES=15

# Optional cited-answer stage. Keep empty until a provider is selected.
# Environment variable names describe a future interface; no loader exists yet.
SECURERAG_GENERATION_ENABLED=false
SECURERAG_LLM_BASE_URL=
SECURERAG_LLM_MODEL=
SECURERAG_LLM_API_KEY=
SECURERAG_LLM_TIMEOUT_SECONDS=30

# Optional network proxy: set only if needed on this machine.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
